{
  "name": "cat-through-time",
  "version": "1.0.0",
  "private": true,
  "description": "A 15-second journey through 16 art eras, drawn in code with React, Canvas and Remotion. One person, one cup and a curious cat.",
  "license": "MIT",
  "author": "hostlife22",
  "homepage": "https://hostlife22.github.io/cat-through-time/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hostlife22/cat-through-time.git"
  },
  "keywords": [
    "art-history",
    "animation",
    "canvas",
    "cat",
    "react",
    "remotion",
    "typescript",
    "vite",
    "procedural-art"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "audio": "python3 scripts/soundtrack.py",
    "render": "npm run audio && node scripts/render.mjs",
    "render:stills": "node scripts/render.mjs --stills",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build",
    "check:preview": "node scripts/verify.mjs --preview-only",
    "check:production": "node scripts/verify-production.mjs",
    "check:video": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/player": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.58.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.2"
  }
}
